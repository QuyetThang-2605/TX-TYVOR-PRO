CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_HEAP_POISONING_LIGHT=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
# CONFIG_TYVOR_UART_PINOUT_VERIFIED is not set
CONFIG_TYVOR_UART_TX_GPIO=-1
CONFIG_TYVOR_UART_RX_GPIO=-1
# CONFIG_TYVOR_TFT_HARDWARE_GATE is not set
# CONFIG_TYVOR_TFT_BOARD_VERIFIED is not set
# CONFIG_TYVOR_TFT_MODULE_VERIFIED is not set
# CONFIG_TYVOR_TFT_TOUCH_RUNTIME is not set
CONFIG_TYVOR_TFT_SIMULATOR=y
CONFIG_TYVOR_TFT_BOOT_DIAGNOSTICS=y
CONFIG_TYVOR_TFT_ROTATION=1
CONFIG_TYVOR_TFT_SCLK=-1
CONFIG_TYVOR_TFT_MOSI=-1
CONFIG_TYVOR_TFT_MISO=-1
CONFIG_TYVOR_TFT_CS=-1
CONFIG_TYVOR_TFT_DC=-1
CONFIG_TYVOR_TFT_RESET=-1
CONFIG_TYVOR_TFT_BACKLIGHT=-1
